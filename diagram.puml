@startuml
top to bottom direction
skinparam linetype ortho
skinparam classAttributeIconSize 0
hide empty members

interface OperationModule {
    +getControlWidget(): QWidget
    +getPreviewWidget(): QWidget
}

class PocketModule {
    -data: Data
    -service: Service
    +getControlWidget(): QWidget
    +getPreviewWidget(): QWidget
}

class DrillingModule {
    -data: Data
    -service: Service
    +getControlWidget(): QWidget
    +getPreviewWidget(): QWidget
}

class App {
    -ControlWidget: QWidget
    -PreviewWidget: QWidget
}

abstract class QWidget {
}

class PocketPreviewWidget {
    +pocketService: Service
    +previewEdit: QPlainTextEdit
    +update()
}

class DrillingPreviewWidget {
    +pocketService: Service
    +previewEdit: QPlainTextEdit
    +update()
}

class PocketControlWidget {
}

class DrillingControlWidget {
}

OperationModule <|-- PocketModule
OperationModule <|-- DrillingModule
App ..> OperationModule

QWidget <|-- PocketPreviewWidget
QWidget <|-- PocketControlWidget
QWidget <|-- DrillingPreviewWidget
QWidget <|-- DrillingControlWidget

App ..> QWidget

PocketModule ..> PocketPreviewWidget
PocketModule ..> PocketControlWidget
DrillingModule ..> DrillingPreviewWidget
DrillingModule ..> DrillingControlWidget

@enduml